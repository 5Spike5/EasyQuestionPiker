      "title": "一次函数基础题",
      "tags": ["初中数学", "函数"],
      "sections": [
        {
          "label": "题干",
          "blocks": [
            {
              "type": "text",
              "value": "已知一次函数 y = 2x + 3，求当 x = 4 时的函数值。"
            }
          ]
        },
        {
          "label": "答案",
          "blocks": [
            {
              "type": "text",
              "value": "11"
            }
          ]
        },
        {
          "label": "解析",
          "blocks": [
            {
              "type": "text",
              "value": "代入 x = 4，得到 y = 2 * 4 + 3 = 11。"
            }
          ]
        }
      ]
    },
